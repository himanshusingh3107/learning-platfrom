# ==========================================
# Learning Platform - Environment Variables
# ==========================================

# 1. Flask Security & Secret Key
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_hex_secret_in_production

# 2. Application Environment & Debug
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000

# 3. Database Connection
# SQLite (default local file):
DATABASE_URL=sqlite:///learning_platform.db
# PostgreSQL (for Render, Railway, AWS RDS, etc.):
# DATABASE_URL=postgresql://username:password@hostname:5432/dbname
# Turso LibSQL (optional serverless DB):
# TURSO_DATABASE_URL=https://your-db.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token

# 4. HTTPS Cookie Security (Set to 1 when running with SSL/HTTPS)
SESSION_COOKIE_SECURE=1

# 5. Administrator Contact & System Defaults
ADMIN_EMAIL=vs6231588@gmail.com

